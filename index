  </main>

  <script>
    let activeRecords = [];

    // Conjuntos de filtros activos de checkbox
    let selectedTurnos = new Set();
    let selectedCargos = new Set();

    // Rango global de fechas
    let minDataDate = '';
    let maxDataDate = '';

    // Instancias de Chart.js
    let chartLocal = null;
    let chartCargo = null;
    let chartTime = null;
    let chartRotacion = null;

    window.addEventListener('DOMContentLoaded', () => {
      setupDnD();
      recalculateDashboard();
    });

    function setupDnD() {
      const zone = document.getElementById('dropZone');
      ['dragenter', 'dragover'].forEach(evt => {
        zone.addEventListener(evt, e => { e.preventDefault(); zone.classList.add('dragover'); }, false);
      });
      ['dragleave', 'drop'].forEach(evt => {
        zone.addEventListener(evt, e => { e.preventDefault(); zone.classList.remove('dragover'); }, false);
      });
      zone.addEventListener('drop', e => {
        const files = e.dataTransfer.files;
        if (files.length > 0) parseUploadedExcel(files[0]);
      });
    }

    function handleNewExcel(event) {
      const file = event.target.files[0];
      if (file) parseUploadedExcel(file);
    }

    // Procesamiento en caliente del Excel
    function parseUploadedExcel(file) {
      const reader = new FileReader();
      reader.onload = function(e) {
        try {
          const data = new Uint8Array(e.target.result);
          const wb = XLSX.read(data, {type: 'array', cellDates: true});

          // Buscar la pestaña RESUMEN_TR
          let targetSheetName = wb.SheetNames.find(s => s.toUpperCase().includes('RESUMEN_TR'));
          if (!targetSheetName) {
            targetSheetName = wb.SheetNames.find(s => s.toUpperCase().includes('RESUMEN')) || wb.SheetNames[0];
          }

          const sheet = wb.Sheets[targetSheetName];
          const raw = XLSX.utils.sheet_to_json(sheet);

          const newRows = [];
          raw.forEach((r, idx) => {
            const local = String(r['Local'] || r['LOCAL'] || '').replace('\n', '').trim();
            const unidad = String(r['Unidad'] || r['UNIDAD'] || '').trim();
            const turno = String(r['Turno'] || r['TURNO'] || '').trim();
            const cargo = String(r['Cargo'] || r['CARGO'] || '').trim();
            const descanso = String(r['Descanso'] || r['DESCANSO'] || '').trim();

            let fechaStr = '';
            const fVal = r['Fecha'] || r['FECHA'];
            if (fVal) {
              if (fVal instanceof Date) fechaStr = fVal.toISOString().split('T')[0];
              else fechaStr = String(fVal).substring(0, 10);
            }

            const trVal = parseFloat(r['TR'] || 0) || 0;
            const cantVal = parseFloat(r['Cantidad'] || r['CANTIDAD'] || 0) || 0;
            
            // Campos de Rotación: Altas y Bajas
            const altasVal = parseFloat(r['Cant Fechain'] || r['Cant_Fechain'] || r['Fechain'] || 0) || 0;
            const bajasVal = parseFloat(r['Cant Fechaout'] || r['Cant_Fechaout'] || r['Fechaout'] || 0) || 0;

            // Cálculos rigurosos de cobertura contractual
            const efectivaVal = Math.min(cantVal, trVal);
            const deficitVal = Math.max(trVal - cantVal, 0);
            const superavitVal = Math.max(cantVal - trVal, 0);
            const cumpVal = trVal > 0 ? Math.round((efectivaVal / trVal) * 1000) / 10 : 100.0;

            if (local || fechaStr) {
              newRows.push({
                id: idx + 1,
                unidad: unidad || 'NO ESPECIFICADO',
                local: local || 'NO ESPECIFICADO',
                turno: turno || 'M',
                cargo: cargo || 'GENERAL',
                tr: trVal,
                descanso: descanso,
                fecha: fechaStr,
                cantidad: cantVal,
                efectiva: efectivaVal,
                faltante: deficitVal,
                superavit: superavitVal,
                altas: altasVal,
                bajas: bajasVal,
                cumplimiento: cumpVal
              });
            }
          });

          if (newRows.length > 0) {
            activeRecords = newRows;
            document.getElementById('activeFileTag').textContent = `Activo: ${file.name} (${newRows.length} filas)`;
            initDropdownsAndPeriod();
            recalculateDashboard();
            alert(`¡Carga exitosa! Se procesaron ${newRows.length} registros con identidad visual SSAYS.`);
          } else {
            alert('No se encontraron registros válidos en la hoja ' + targetSheetName);
          }
        } catch (err) {
          console.error(err);
          alert('Error al leer el archivo Excel: ' + err.message);
        }
      };
      reader.readAsArrayBuffer(file);
    }

    function initDropdownsAndPeriod() {
      const uniSel = document.getElementById('selUnidad');
      const unidades = Array.from(new Set(activeRecords.map(r => r.unidad))).filter(Boolean).sort();
      uniSel.innerHTML = '<option value="ALL">Todas las Unidades</option>' + unidades.map(u => `<option value="${u}">${u}</option>`).join('');

      updateLocalesDropdown();

      const fechas = Array.from(new Set(activeRecords.map(r => r.fecha))).filter(Boolean).sort();
      if (fechas.length > 0) {
        minDataDate = fechas[0];
        maxDataDate = fechas[fechas.length - 1];
        
        const fDesde = document.getElementById('fechaDesde');
        const fHasta = document.getElementById('fechaHasta');
        
        fDesde.min = minDataDate;
        fDesde.max = maxDataDate;
        fDesde.value = minDataDate;

        fHasta.min = minDataDate;
        fHasta.max = maxDataDate;
        fHasta.value = maxDataDate;

        document.getElementById('lblPeriodoInfo').textContent = `(${minDataDate} al ${maxDataDate})`;
      }

      const turnos = Array.from(new Set(activeRecords.map(r => r.turno))).filter(Boolean).sort();
      selectedTurnos = new Set(turnos);
      renderChips('turno', turnos, selectedTurnos, document.getElementById('turnoChipsContainer'));

      const cargos = Array.from(new Set(activeRecords.map(r => r.cargo))).filter(Boolean).sort();
      selectedCargos = new Set(cargos);
      renderChips('cargo', cargos, selectedCargos, document.getElementById('cargoChipsContainer'));
    }

    function renderChips(type, items, selectedSet, container) {
      container.innerHTML = '';
      items.forEach(item => {
        const isChecked = selectedSet.has(item);
        const chip = document.createElement('div');
        chip.className = `chip-item ${isChecked ? 'active' : ''}`;
        chip.innerHTML = `
          <span class="chk-icon">${isChecked ? '✓' : ''}</span>
          <span>${item}</span>
        `;
        chip.onclick = () => {
          if (selectedSet.has(item)) {
            selectedSet.delete(item);
          } else {
            selectedSet.add(item);
          }
          chip.classList.toggle('active', selectedSet.has(item));
          chip.querySelector('.chk-icon').textContent = selectedSet.has(item) ? '✓' : '';
          recalculateDashboard();
        };
        container.appendChild(chip);
      });
    }

    function toggleAllChips(type, selectAll) {
      if (type === 'turno') {
        const turnos = Array.from(new Set(activeRecords.map(r => r.turno))).filter(Boolean);
        selectedTurnos = selectAll ? new Set(turnos) : new Set();
        renderChips('turno', turnos.sort(), selectedTurnos, document.getElementById('turnoChipsContainer'));
      } else if (type === 'cargo') {
        const cargos = Array.from(new Set(activeRecords.map(r => r.cargo))).filter(Boolean);
        selectedCargos = selectAll ? new Set(cargos) : new Set();
        renderChips('cargo', cargos.sort(), selectedCargos, document.getElementById('cargoChipsContainer'));
      }
      recalculateDashboard();
    }

    function onUnidadChange() {
      updateLocalesDropdown();
      recalculateDashboard();
    }

    function updateLocalesDropdown() {
      const selectedUnidad = document.getElementById('selUnidad').value;
      const locSel = document.getElementById('selLocal');

      let locales = [];
      if (selectedUnidad === 'ALL') {
        locales = Array.from(new Set(activeRecords.map(r => r.local))).filter(Boolean).sort();
        document.getElementById('localDependantLabel').textContent = '(Todos los locales)';
      } else {
        locales = Array.from(new Set(activeRecords.filter(r => r.unidad === selectedUnidad).map(r => r.local))).filter(Boolean).sort();
        document.getElementById('localDependantLabel').textContent = `(Asociados a: ${selectedUnidad})`;
      }

      locSel.innerHTML = '<option value="ALL">Todos los Locales</option>' + locales.map(l => `<option value="${l}">${l}</option>`).join('');
    }

    function clearFilters() {
      document.getElementById('searchTxt').value = '';
      document.getElementById('selUnidad').value = 'ALL';
      updateLocalesDropdown();

      if (minDataDate && maxDataDate) {
        document.getElementById('fechaDesde').value = minDataDate;
        document.getElementById('fechaHasta').value = maxDataDate;
      }

      toggleAllChips('turno', true);
      toggleAllChips('cargo', true);
      recalculateDashboard();
    }

    function recalculateDashboard() {
      const search = document.getElementById('searchTxt').value.toLowerCase().trim();
      const unidad = document.getElementById('selUnidad').value;
      const local = document.getElementById('selLocal').value;
      const fDesde = document.getElementById('fechaDesde').value;
      const fHasta = document.getElementById('fechaHasta').value;

      const filtered = activeRecords.filter(r => {
        if (unidad !== 'ALL' && r.unidad !== unidad) return false;
        if (local !== 'ALL' && r.local !== local) return false;
        
        if (fDesde && r.fecha && r.fecha < fDesde) return false;
        if (fHasta && r.fecha && r.fecha > fHasta) return false;

        if (selectedTurnos.size > 0 && !selectedTurnos.has(r.turno)) return false;
        if (selectedTurnos.size === 0) return false;

        if (selectedCargos.size > 0 && !selectedCargos.has(r.cargo)) return false;
        if (selectedCargos.size === 0) return false;

        if (search) {
          const txt = (r.local + ' ' + r.unidad + ' ' + r.cargo + ' ' + r.turno + ' ' + r.fecha).toLowerCase();
          if (!txt.includes(search)) return false;
        }
        return true;
      });

      renderKPIs(filtered);
      renderCharts(filtered);
      renderTable(filtered);
    }

    function renderKPIs(data) {
      const totalTR = data.reduce((a, b) => a + b.tr, 0);
      const totalCantBruta = data.reduce((a, b) => a + b.cantidad, 0);
      const totalEfectiva = data.reduce((a, b) => a + b.efectiva, 0);
      const totalFaltante = data.reduce((a, b) => a + b.faltante, 0);
      const totalSuperavit = data.reduce((a, b) => a + b.superavit, 0);

      const pctEfectivo = totalTR > 0 ? Math.round((totalEfectiva / totalTR) * 1000) / 10 : 100.0;
      
      const turnosConDeficit = data.filter(r => r.faltante > 0).length;
      const totalTurnos = data.length;
      const pctNivelServicio = totalTurnos > 0 ? Math.round(((totalTurnos - turnosConDeficit) / totalTurnos) * 1000) / 10 : 100.0;

      document.getElementById('kpiTR').textContent = totalTR.toLocaleString();
      document.getElementById('kpiAsistEfectiva').textContent = totalEfectiva.toLocaleString();
      document.getElementById('kpiAsistBrutaSub').textContent = `Total asistencias: ${totalCantBruta.toLocaleString()}`;
      
      document.getElementById('kpiFaltante').textContent = totalFaltante.toLocaleString();
      document.getElementById('kpiSuperavit').textContent = `+${totalSuperavit.toLocaleString()}`;
      
      document.getElementById('kpiCumplimientoEfectivo').textContent = pctEfectivo + '%';
      document.getElementById('kpiNivelServicio').textContent = pctNivelServicio + '%';
      document.getElementById('kpiQuiebresSub').textContent = `${turnosConDeficit} de ${totalTurnos} turnos con falta`;

      const badge = document.getElementById('kpiCumpBadge');
      if (pctEfectivo >= 98) {
        badge.innerHTML = '<span class="badge-tag tag-ok">Meta Cumplida (≥98%)</span>';
      } else if (pctEfectivo >= 92) {
        badge.innerHTML = '<span class="badge-tag tag-warn">Alerta Leve (92% - 97%)</span>';
      } else {
        badge.innerHTML = '<span class="badge-tag tag-danger">Déficit Crítico (&lt;92%)</span>';
      }

      // Módulo Rotación
      const totalAltas = data.reduce((a, b) => a + b.altas, 0);
      const totalBajas = data.reduce((a, b) => a + b.bajas, 0);
      const balanceNeto = totalAltas - totalBajas;

      const uniqueDays = new Set(data.map(r => r.fecha)).size || 1;
      const dotacionPromedioDiaria = Math.round((totalCantBruta / uniqueDays) * 10) / 10;

      const tasaRotacion = dotacionPromedioDiaria > 0 ? Math.round((totalBajas / dotacionPromedioDiaria) * 1000) / 10 : 0.0;

      document.getElementById('kpiDotacionPromedio').textContent = dotacionPromedioDiaria.toLocaleString();
      document.getElementById('kpiTotalAltas').textContent = `+${totalAltas.toLocaleString()}`;
      document.getElementById('kpiTotalBajas').textContent = `-${totalBajas.toLocaleString()}`;
      document.getElementById('kpiTasaRotacion').textContent = tasaRotacion + '%';
      
      const balEl = document.getElementById('kpiBalanceNeto');
      balEl.textContent = (balanceNeto >= 0 ? '+' : '') + balanceNeto.toLocaleString();
      balEl.style.color = balanceNeto < 0 ? '#ef4444' : (balanceNeto > 0 ? '#4ade80' : '#fff');

      document.getElementById('kpiBalanceSub').textContent = balanceNeto >= 0 ? 'Crecimiento neto' : 'Pérdida neta de plantilla';
    }

    function renderCharts(data) {
      // 1. Barras por Local (Colores SSAYS: Verde Corporativo, Verde Claro, Cyan)
      const localMap = {};
      data.forEach(r => {
        if (!localMap[r.local]) localMap[r.local] = { tr: 0, efectiva: 0, faltante: 0, superavit: 0, altas: 0, bajas: 0 };
        localMap[r.local].tr += r.tr;
        localMap[r.local].efectiva += r.efectiva;
        localMap[r.local].faltante += r.faltante;
        localMap[r.local].superavit += r.superavit;
        localMap[r.local].altas += r.altas;
        localMap[r.local].bajas += r.bajas;
      });

      const localKeys = Object.keys(localMap).sort((a,b) => localMap[b].tr - localMap[a].tr).slice(0, 10);
      const labelsLocal = localKeys.map(k => k.replace('ECOBESA - ', '').replace('PLANTA ', ''));
      const trLocal = localKeys.map(k => localMap[k].tr);
      const efectivaLocal = localKeys.map(k => localMap[k].efectiva);
      const superavitLocal = localKeys.map(k => localMap[k].superavit);

      if (chartLocal) chartLocal.destroy();
      const ctx1 = document.getElementById('chartLocalesTR').getContext('2d');
      chartLocal = new Chart(ctx1, {
        type: 'bar',
        data: {
          labels: labelsLocal,
          datasets: [
            { label: 'Meta TR', data: trLocal, backgroundColor: '#00bdf2', borderRadius: 4 },
            { label: 'Cobertura Efectiva', data: efectivaLocal, backgroundColor: '#009640', borderRadius: 4 },
            { label: 'Apoyo / Superávit', data: superavitLocal, backgroundColor: '#059669', borderRadius: 4 }
          ]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: { legend: { labels: { color: '#cbd5e1' } } },
          scales: {
            y: { grid: { color: '#16382c' }, ticks: { color: '#94a3b8' } },
            x: { grid: { display: false }, ticks: { color: '#94a3b8' } }
          }
        }
      });

      // 2. Dona por Cargo
      const cargoMap = {};
      data.forEach(r => {
        if (!cargoMap[r.cargo]) cargoMap[r.cargo] = 0;
        cargoMap[r.cargo] += r.faltante;
      });

      const cargoLabels = Object.keys(cargoMap);
      const cargoValues = cargoLabels.map(c => cargoMap[c]);

      if (chartCargo) chartCargo.destroy();
      const ctx2 = document.getElementById('chartCargoFaltante').getContext('2d');
      chartCargo = new Chart(ctx2, {
        type: 'doughnut',
        data: {
          labels: cargoLabels,
          datasets: [{
            data: cargoValues.length > 0 && cargoValues.some(v => v > 0) ? cargoValues : [1],
            backgroundColor: ['#ef4444', '#f59e0b', '#00bdf2', '#009640', '#8b5cf6', '#10b981'],
            borderWidth: 2,
            borderColor: '#0e221b'
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: { legend: { position: 'bottom', labels: { color: '#cbd5e1' } } },
          cutout: '65%'
        }
      });

      // 3. Línea Temporal Diaria
      const dateMap = {};
      data.forEach(r => {
        if (!r.fecha) return;
        if (!dateMap[r.fecha]) dateMap[r.fecha] = { tr: 0, efectiva: 0, falt: 0, altas: 0, bajas: 0 };
        dateMap[r.fecha].tr += r.tr;
        dateMap[r.fecha].efectiva += r.efectiva;
        dateMap[r.fecha].falt += r.faltante;
        dateMap[r.fecha].altas += r.altas;
        dateMap[r.fecha].bajas += r.bajas;
      });

      const dateKeys = Object.keys(dateMap).sort();
      const dateTR = dateKeys.map(d => dateMap[d].tr);
      const dateEfectiva = dateKeys.map(d => dateMap[d].efectiva);
      const dateFalt = dateKeys.map(d => dateMap[d].falt);
      const dateAltas = dateKeys.map(d => dateMap[d].altas);
      const dateBajas = dateKeys.map(d => dateMap[d].bajas);

      if (chartTime) chartTime.destroy();
      const ctx3 = document.getElementById('chartTimelineTR').getContext('2d');
      chartTime = new Chart(ctx3, {
        type: 'line',
        data: {
          labels: dateKeys.map(d => d.substring(5)),
          datasets: [
            { label: 'Meta TR', data: dateTR, borderColor: '#00bdf2', borderDash: [4, 4], fill: false, tension: 0.1 },
            { label: 'Cobertura Efectiva', data: dateEfectiva, borderColor: '#009640', backgroundColor: 'rgba(0, 150, 64, 0.12)', fill: true, tension: 0.2 },
            { label: 'Personal por Coberturar', data: dateFalt, borderColor: '#ef4444', fill: false, tension: 0.2 }
          ]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: { legend: { labels: { color: '#cbd5e1' } } },
          scales: {
            y: { grid: { color: '#16382c' }, ticks: { color: '#94a3b8' } },
            x: { grid: { display: false }, ticks: { color: '#94a3b8' } }
          }
        }
      });

      // 4. Gráfico de Rotación: Altas vs Bajas (Verde SSAYS vs Rojo alerta)
      if (chartRotacion) chartRotacion.destroy();
      const ctx4 = document.getElementById('chartRotacionFlujo').getContext('2d');
      chartRotacion = new Chart(ctx4, {
        type: 'bar',
        data: {
          labels: dateKeys.map(d => d.substring(5)),
          datasets: [
            {
              type: 'bar',
              label: 'Nuevas Altas (Ingresos)',
              data: dateAltas,
              backgroundColor: '#009640',
              borderRadius: 3
            },
            {
              type: 'bar',
              label: 'Bajas Totales (Salidas)',
              data: dateBajas,
              backgroundColor: '#ef4444',
              borderRadius: 3
            }
          ]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: { labels: { color: '#cbd5e1' } },
            tooltip: {
              callbacks: {
                label: function(ctx) {
                  return `${ctx.dataset.label}: ${ctx.raw} personas`;
                }
              }
            }
          },
          scales: {
            y: {
              grid: { color: '#16382c' },
              ticks: { color: '#94a3b8', stepSize: 1 }
            },
            x: {
              grid: { display: false },
              ticks: { color: '#94a3b8' }
            }
          }
        }
      });
    }

    function renderTable(data) {
      const tbody = document.getElementById('tblBody');
      document.getElementById('lblCountTable').textContent = `(Mostrando ${data.length} de ${activeRecords.length} registros)`;

      if (data.length === 0) {
        tbody.innerHTML = '<tr><td colspan="16" style="text-align:center; padding:24px; color:#64748b;">No se encontraron registros para los filtros y periodo seleccionados.</td></tr>';
        return;
      }

      tbody.innerHTML = data.slice(0, 300).map((r, i) => {
        let statusTag = '<span class="badge-tag tag-ok">Cumplido</span>';
        if (r.faltante > 0) {
          statusTag = '<span class="badge-tag tag-danger">Con Falta</span>';
        } else if (r.superavit > 0) {
          statusTag = '<span class="badge-tag tag-warn">Apoyo Adic.</span>';
        }

        return `
          <tr>
            <td>${r.id}</td>
            <td><strong>${r.fecha || '-'}</strong></td>
            <td>${r.local}</td>
            <td>${r.unidad}</td>
            <td><span style="background:#081711; padding:2px 6px; border-radius:4px; font-size:0.75rem; border:1px solid var(--card-border);">${r.turno}</span></td>
            <td>${r.cargo}</td>
            <td>${r.descanso || '-'}</td>
            <td class="text-right" style="font-weight:700; color:#00bdf2;">${r.tr}</td>
            <td class="text-right" style="font-weight:700; color:#fff;">${r.cantidad}</td>
            <td class="text-right" style="font-weight:700; color:#4ade80;">${r.efectiva}</td>
            <td class="text-right" style="font-weight:800; color:${r.faltante > 0 ? '#ef4444' : '#94a3b8'};">${r.faltante > 0 ? '-' + r.faltante : '0'}</td>
            <td class="text-right" style="font-weight:700; color:${r.superavit > 0 ? '#059669' : '#94a3b8'};">${r.superavit > 0 ? '+' + r.superavit : '0'}</td>
            <td class="text-center font-weight-bold" style="color:${r.altas > 0 ? '#4ade80' : '#64748b'};">${r.altas > 0 ? '+' + r.altas : '0'}</td>
            <td class="text-center font-weight-bold" style="color:${r.bajas > 0 ? '#ef4444' : '#64748b'};">${r.bajas > 0 ? '-' + r.bajas : '0'}</td>
            <td class="text-center font-weight-bold">${r.cumplimiento}%</td>
            <td class="text-center">${statusTag}</td>
          </tr>
        `;
      }).join('');
    }

    function exportDataToCSV() {
      if (activeRecords.length === 0) return alert('No hay datos para exportar.');
      let csv = "ID,Fecha,Local,Unidad,Turno,Cargo,Descanso,TR_Meta,Cantidad_Asistente,Asistencia_Efectiva,Faltante,Superavit,Altas_Fechain,Bajas_Fechaout,Cobertura_Pct\n";
      activeRecords.forEach(r => {
        csv += `"${r.id}","${r.fecha}","${r.local}","${r.unidad}","${r.turno}","${r.cargo}","${r.descanso}",${r.tr},${r.cantidad},${r.efectiva},${r.faltante},${r.superavit},${r.altas},${r.bajas},"${r.cumplimiento}%"\n`;
      });
      const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
      const link = document.createElement("a");
      link.href = URL.createObjectURL(blob);
      link.setAttribute("download", `Reporte_SSAYS_TR_Rotacion_${new Date().toISOString().slice(0,10)}.csv`);
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
    }
  </script>
</body>
</html>
