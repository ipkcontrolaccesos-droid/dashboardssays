<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>SSAYS - Centro de Control de Dotación Contractual (TR) & Rotación</title>
  <!-- SheetJS y Chart.js CDN -->
  <script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
  <style>
    :root {
      /* Paleta Corporativa SSAYS */
      --ssays-green: #006837;
      --ssays-green-light: #009640;
      --ssays-green-dark: #004d25;
      --ssays-cyan: #00bdf2;
      --ssays-cyan-hover: #00a4d4;
      
      /* Fondos y Estructura en Modo Ejecutivo */
      --bg-dark: #07130e;
      --card-bg: #0e221b;
      --card-border: #16382c;
      --card-border-hover: #009640;
      
      /* Acentos de Datos */
      --accent-blue: #00bdf2;
      --accent-green: #10b981;
      --accent-emerald: #059669;
      --accent-amber: #f59e0b;
      --accent-rose: #ef4444;
      --accent-purple: #8b5cf6;
      
      /* Tipografía y sombras */
      --text-main: #f8fafc;
      --text-muted: #94a3b8;
      --shadow: 0 4px 12px -2px rgba(0, 0, 0, 0.45), 0 2px 4px -2px rgba(0, 0, 0, 0.3);
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: 'Segoe UI', -apple-system, BlinkMacSystemFont, Roboto, sans-serif;
    }

    body {
      background-color: var(--bg-dark);
      background-image: radial-gradient(circle at 15% 10%, rgba(0, 104, 55, 0.15) 0%, transparent 40%),
                        radial-gradient(circle at 85% 20%, rgba(0, 189, 242, 0.1) 0%, transparent 35%);
      color: var(--text-main);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    /* Barra Superior Corporativa */
    .command-header {
      background: linear-gradient(90deg, #061510 0%, #0c241c 50%, #061510 100%);
      padding: 12px 28px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-bottom: 2px solid var(--ssays-green);
      box-shadow: 0 4px 20px rgba(0, 104, 55, 0.25);
    }

    .brand-group {
      display: flex;
      align-items: center;
      gap: 18px;
    }

    .logo-container {
      background: #ffffff;
      padding: 6px 14px;
      border-radius: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.35);
    }

    .logo-container svg {
      height: 34px;
      width: auto;
      display: block;
    }

    .brand-title h1 {
      font-size: 1.18rem;
      font-weight: 800;
      color: #ffffff;
      letter-spacing: -0.3px;
    }

    .brand-title p {
      font-size: 0.77rem;
      color: var(--ssays-cyan);
      font-weight: 600;
    }

    .pill-file {
      background: rgba(14, 34, 27, 0.85);
      border: 1px solid var(--card-border);
      border-radius: 20px;
      padding: 6px 14px;
      font-size: 0.76rem;
      color: #cbd5e1;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .pill-file .status-dot {
      width: 8px;
      height: 8px;
      background-color: var(--ssays-cyan);
      border-radius: 50%;
      box-shadow: 0 0 10px var(--ssays-cyan);
    }

    .dashboard-body {
      padding: 20px 28px;
      max-width: 1750px;
      margin: 0 auto;
      width: 100%;
      display: flex;
      flex-direction: column;
      gap: 18px;
    }

    /* Zona Drag & Drop con estilo SSAYS */
    .dropzone-container {
      background: var(--card-bg);
      border: 2px dashed var(--ssays-green-light);
      border-radius: 10px;
      padding: 14px 24px;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: space-between;
      transition: all 0.25s ease;
      box-shadow: var(--shadow);
    }

    .dropzone-container:hover, .dropzone-container.dragover {
      background: #112d23;
      border-color: var(--ssays-cyan);
      box-shadow: 0 0 16px rgba(0, 189, 242, 0.25);
    }

    .dropzone-text {
      display: flex;
      align-items: center;
      gap: 14px;
    }

    .dropzone-icon {
      font-size: 26px;
      background: rgba(0, 189, 242, 0.12);
      border: 1px solid rgba(0, 189, 242, 0.3);
      width: 44px;
      height: 44px;
      border-radius: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--ssays-cyan);
    }

    .btn {
      padding: 7px 16px;
      border-radius: 6px;
      font-size: 0.82rem;
      font-weight: 700;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      border: 1px solid transparent;
      transition: all 0.2s ease;
    }

    .btn-ssays {
      background: linear-gradient(135deg, var(--ssays-green-light) 0%, var(--ssays-green) 100%);
      color: #ffffff;
      box-shadow: 0 2px 6px rgba(0, 104, 55, 0.35);
    }
    .btn-ssays:hover {
      background: linear-gradient(135deg, #00aa48 0%, var(--ssays-green-light) 100%);
      transform: translateY(-1px);
    }

    .btn-dark {
      background: #122b22;
      color: #e2e8f0;
      border: 1px solid var(--card-border);
    }
    .btn-dark:hover {
      background: #183a2e;
      border-color: var(--ssays-green-light);
    }

    /* Banner Informativo */
    .client-alert-banner {
      background: linear-gradient(90deg, rgba(14, 34, 27, 0.95) 0%, rgba(10, 24, 19, 0.95) 100%);
      border-left: 4px solid var(--ssays-cyan);
      border-radius: 8px;
      padding: 12px 18px;
      font-size: 0.82rem;
      color: #cbd5e1;
      display: flex;
      align-items: center;
      justify-content: space-between;
      line-height: 1.4;
      box-shadow: var(--shadow);
    }

    .client-alert-banner strong {
      color: var(--ssays-cyan);
    }

    /* Estructura Modular de Filtros */
    .filters-section {
      background: var(--card-bg);
      border: 1px solid var(--card-border);
      border-radius: 10px;
      padding: 16px 20px;
      display: flex;
      flex-direction: column;
      gap: 14px;
      box-shadow: var(--shadow);
    }

    .filter-row-top {
      display: grid;
      grid-template-columns: 1.3fr 1.3fr 1.8fr 1.8fr auto;
      gap: 14px;
      align-items: center;
    }

    .filter-row-bottom {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px;
      padding-top: 12px;
      border-top: 1px solid rgba(255, 255, 255, 0.08);
    }

    .filter-block {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    .filter-block label {
      font-size: 0.73rem;
      text-transform: uppercase;
      font-weight: 700;
      color: var(--ssays-cyan);
      letter-spacing: 0.5px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .filter-block label span.sub-info {
      color: var(--text-muted);
      font-weight: normal;
      font-size: 0.7rem;
    }

    .form-control {
      background: #081711;
      border: 1px solid var(--card-border);
      color: #f8fafc;
      padding: 7px 12px;
      border-radius: 6px;
      font-size: 0.82rem;
      outline: none;
      transition: all 0.2s ease;
    }

    .form-control:focus {
      border-color: var(--ssays-cyan);
      box-shadow: 0 0 8px rgba(0, 189, 242, 0.3);
    }

    /* Selector de Periodo */
    .date-range-inputs {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .date-range-inputs span {
      color: var(--text-muted);
      font-size: 0.75rem;
      font-weight: 600;
    }

    .date-range-inputs input[type="date"] {
      background: #081711;
      border: 1px solid var(--card-border);
      color: #f8fafc;
      padding: 6px 10px;
      border-radius: 6px;
      font-size: 0.8rem;
      outline: none;
      width: 100%;
    }

    .date-range-inputs input[type="date"]:focus {
      border-color: var(--ssays-cyan);
    }

    /* Chips / Checkboxes Interactivos */
    .chips-group {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      align-items: center;
    }

    .chip-item {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: #081711;
      border: 1px solid var(--card-border);
      border-radius: 6px;
      padding: 6px 12px;
      font-size: 0.8rem;
      color: #cbd5e1;
      cursor: pointer;
      user-select: none;
      transition: all 0.15s ease;
    }

    .chip-item:hover {
      border-color: var(--ssays-green-light);
      background: #0e291e;
    }

    .chip-item.active {
      background: rgba(0, 150, 64, 0.22);
      border-color: var(--ssays-green-light);
      color: #4ade80;
      font-weight: 700;
    }

    .chip-item .chk-icon {
      width: 14px;
      height: 14px;
      border: 1px solid #335948;
      border-radius: 3px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 10px;
    }

    .chip-item.active .chk-icon {
      background-color: var(--ssays-green-light);
      border-color: var(--ssays-green-light);
      color: #ffffff;
    }

    .chip-actions {
      display: flex;
      gap: 6px;
      margin-left: auto;
    }

    .link-action {
      font-size: 0.68rem;
      color: var(--ssays-cyan);
      cursor: pointer;
      text-decoration: underline;
    }
    .link-action:hover { color: #ffffff; }

    /* Títulos de Grupo de KPIs */
    .section-title {
      font-size: 0.82rem;
      text-transform: uppercase;
      letter-spacing: 0.8px;
      font-weight: 800;
      color: #e2e8f0;
      display: flex;
      align-items: center;
      gap: 8px;
      margin-top: 4px;
    }

    .section-title::after {
      content: '';
      flex: 1;
      height: 1px;
      background: linear-gradient(90deg, var(--card-border) 0%, transparent 100%);
    }

    /* Tarjetas KPI */
    .kpis-grid {
      display: grid;
      grid-template-columns: repeat(6, 1fr);
      gap: 14px;
    }

    .kpis-grid-rotacion {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      gap: 14px;
    }

    .kpi-box {
      background: var(--card-bg);
      border: 1px solid var(--card-border);
      border-radius: 10px;
      padding: 16px;
      position: relative;
      overflow: hidden;
      box-shadow: var(--shadow);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      transition: transform 0.18s ease, border-color 0.18s ease;
    }

    .kpi-box:hover {
      transform: translateY(-2px);
      border-color: rgba(0, 189, 242, 0.4);
    }

    .kpi-box::after {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 3px;
    }

    .kpi-box.accent-blue::after { background: var(--ssays-cyan); }
    .kpi-box.accent-green::after { background: var(--ssays-green-light); }
    .kpi-box.accent-rose::after { background: var(--accent-rose); }
    .kpi-box.accent-indigo::after { background: #38bdf8; }
    .kpi-box.accent-amber::after { background: var(--accent-amber); }
    .kpi-box.accent-cyan::after { background: var(--ssays-cyan); }
    .kpi-box.accent-purple::after { background: var(--accent-purple); }

    .kpi-box .label {
      font-size: 0.72rem;
      color: var(--text-muted);
      text-transform: uppercase;
      font-weight: 700;
    }

    .kpi-box .val {
      font-size: 1.75rem;
      font-weight: 800;
      margin: 6px 0;
      color: #ffffff;
    }

    .kpi-box .foot {
      font-size: 0.72rem;
      color: var(--text-muted);
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .badge-tag {
      display: inline-block;
      padding: 2px 7px;
      border-radius: 12px;
      font-size: 0.7rem;
      font-weight: 700;
    }

    .tag-ok { background: rgba(0, 150, 64, 0.25); color: #4ade80; border: 1px solid rgba(0, 150, 64, 0.4); }
    .tag-warn { background: rgba(245, 158, 11, 0.2); color: #fbbf24; border: 1px solid rgba(245, 158, 11, 0.4); }
    .tag-danger { background: rgba(239, 68, 68, 0.2); color: #f87171; border: 1px solid rgba(239, 68, 68, 0.4); }

    /* Gráficos */
    .grid-2x1 {
      display: grid;
      grid-template-columns: 2fr 1fr;
      gap: 16px;
    }

    .grid-1x1 {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px;
    }

    .chart-box {
      background: var(--card-bg);
      border: 1px solid var(--card-border);
      border-radius: 10px;
      padding: 18px;
      box-shadow: var(--shadow);
      display: flex;
      flex-direction: column;
    }

    .chart-head {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 14px;
      padding-bottom: 8px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    }

    .chart-head h4 {
      font-size: 0.9rem;
      font-weight: 700;
      color: #f1f5f9;
    }

    .chart-wrap {
      position: relative;
      flex-grow: 1;
      min-height: 280px;
      width: 100%;
    }

    /* Tabla */
    .table-section {
      background: var(--card-bg);
      border: 1px solid var(--card-border);
      border-radius: 10px;
      padding: 18px;
      box-shadow: var(--shadow);
    }

    .table-head-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 12px;
    }

    .table-scroll {
      max-height: 420px;
      overflow-y: auto;
      border: 1px solid var(--card-border);
      border-radius: 6px;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.78rem;
      text-align: left;
    }

    thead th {
      background: #081711;
      color: var(--ssays-cyan);
      font-weight: 700;
      padding: 10px 12px;
      position: sticky;
      top: 0;
      border-bottom: 2px solid var(--card-border);
      z-index: 2;
      white-space: nowrap;
    }

    tbody tr {
      border-bottom: 1px solid rgba(22, 56, 44, 0.6);
      transition: background 0.15s;
    }

    tbody tr:hover { background: rgba(0, 189, 242, 0.08); }
    tbody td { padding: 9px 12px; color: #e2e8f0; white-space: nowrap; }
    .text-right { text-align: right; }
    .text-center { text-align: center; }

    @media (max-width: 1400px) {
      .kpis-grid { grid-template-columns: repeat(3, 1fr); }
      .kpis-grid-rotacion { grid-template-columns: repeat(3, 1fr); }
      .filter-row-top { grid-template-columns: 1fr; }
      .filter-row-bottom { grid-template-columns: 1fr; }
      .grid-2x1, .grid-1x1 { grid-template-columns: 1fr; }
    }
    @media (max-width: 800px) {
      .kpis-grid, .kpis-grid-rotacion { grid-template-columns: 1fr; }
    }
  </style>
</head>
<body>

  <header class="command-header">
    <div class="brand-group">
      <!-- Isotipo / Logotipo Vectorial de SSAYS -->
      <div class="logo-container">
        <svg viewBox="0 0 350 90" xmlns="http://www.w3.org/2000/svg">
          <!-- S superior verde -->
          <path d="M15 15 C35 12, 60 12, 75 15 C85 17, 85 30, 75 33 C55 35, 30 35, 15 33 C5 31, 5 17, 15 15 Z" fill="#006837" />
          <!-- Cinta central celeste -->
          <path d="M10 40 C35 38, 55 38, 80 40 C85 41, 85 51, 80 52 C55 54, 35 54, 10 52 C5 51, 5 41, 10 40 Z" fill="#00BDF2" />
          <!-- S inferior verde -->
          <path d="M15 59 C30 57, 55 57, 75 59 C85 61, 85 75, 75 77 C60 80, 35 80, 15 77 C5 75, 5 61, 15 59 Z" fill="#006837" />
          <!-- Texto SSAYS -->
          <text x="95" y="65" font-family="'Segoe UI', Roboto, sans-serif" font-weight="900" font-size="52" fill="#006837" letter-spacing="3">SSAYS</text>
        </svg>
      </div>
      <div class="brand-title">
        <h1>Centro de Control de Dotación Contractual (TR) & Rotación</h1>
        <p>Sistema Integrado de Monitoreo Operativo &bull; Cobertura Efectiva, Altas, Bajas y Nivel de Servicio</p>
      </div>
    </div>
    <div style="display:flex; align-items:center; gap:12px;">
      <div class="pill-file">
        <span class="status-dot"></span>
        <span id="activeFileTag">Esperando archivo...</span>
      </div>
      <button class="btn btn-dark" onclick="window.print()">🖨️ Imprimir</button>
    </div>
  </header>

  <main class="dashboard-body">

    <!-- Subida de Excel -->
    <div class="dropzone-container" id="dropZone" onclick="document.getElementById('fileUploadInput').click()">
      <input type="file" id="fileUploadInput" accept=".xlsx, .xlsm, .xls" style="display: none;" onchange="handleNewExcel(event)">
      <div class="dropzone-text">
        <div class="dropzone-icon">📥</div>
        <div>
          <h3 style="font-size:0.95rem; font-weight:700; color:#f1f5f9;">Cargar archivo Excel / Tareo (.xlsx / .xlsm)</h3>
          <p style="font-size:0.8rem; color:var(--text-muted);">Arrastra o haz clic para cargar. Se leerán automáticamente TR, asistencias, altas (Fechain) y bajas (Fechaout).</p>
        </div>
      </div>
      <div>
        <button class="btn btn-ssays" onclick="event.stopPropagation(); document.getElementById('fileUploadInput').click()">
          📁 Cargar Archivo
        </button>
      </div>
    </div>

    <!-- Banner Informativo -->
    <div class="client-alert-banner">
      <div>
        💡 <strong>Auditoría Contractual y Rotación de Personal SSAYS:</strong> 
        La <em>Cobertura Efectiva</em> no compensa faltantes con apoyos de otros turnos. A su vez, el módulo de rotación calcula las <em>Nuevas Altas</em> y <em>Bajas</em> para sustentar ante el cliente las variaciones de dotación.
      </div>
      <span style="font-size:0.75rem; color:#94a3b8;">Rotación (%) = (Bajas / Dotación Promedio) × 100</span>
    </div>

    <!-- Segmentadores: Cascada Unidad -> Local, Rango de Fecha y Checkboxes para Turno y Cargo -->
    <section class="filters-section">
      <!-- Fila 1: Filtros de Selección y Jerarquía -->
      <div class="filter-row-top">
        <!-- 1. Desplegable de Unidad -->
        <div class="filter-block">
          <label for="selUnidad">🏢 Unidad de Negocio</label>
          <select id="selUnidad" class="form-control" onchange="onUnidadChange()">
            <option value="ALL">Todas las Unidades</option>
          </select>
        </div>

        <!-- 2. Desplegable de Local (Filtrado dependiente de la Unidad) -->
        <div class="filter-block">
          <label for="selLocal">📍 Local / Sede <span class="sub-info" id="localDependantLabel">(Asociado a Unidad)</span></label>
          <select id="selLocal" class="form-control" onchange="recalculateDashboard()">
            <option value="ALL">Todos los Locales</option>
          </select>
        </div>

        <!-- 3. Selector de Periodo (Rango Desde - Hasta) -->
        <div class="filter-block">
          <label>📅 Selector de Periodo <span class="sub-info" id="lblPeriodoInfo">(Rango de fechas)</span></label>
          <div class="date-range-inputs">
            <span>Desde:</span>
            <input type="date" id="fechaDesde" onchange="recalculateDashboard()">
            <span>Hasta:</span>
            <input type="date" id="fechaHasta" onchange="recalculateDashboard()">
          </div>
        </div>

        <!-- 4. Buscador Libre -->
        <div class="filter-block">
          <label for="searchTxt">🔍 Buscador Libre</label>
          <input type="text" id="searchTxt" class="form-control" placeholder="Buscar por palabra clave..." oninput="recalculateDashboard()">
        </div>

        <!-- Botón Limpiar -->
        <div class="filter-block" style="justify-content: flex-end;">
          <label>&nbsp;</label>
          <button class="btn btn-dark" onclick="clearFilters()">🧹 Limpiar Todo</button>
        </div>
      </div>

      <!-- Fila 2: Selección Múltiple con Checkboxes/Chips para Turno y Cargo -->
      <div class="filter-row-bottom">
        <!-- Selección de Turnos -->
        <div class="filter-block">
          <label>
            <span>⏱️ Turnos Seleccionados</span>
            <span class="chip-actions">
              <span class="link-action" onclick="toggleAllChips('turno', true)">Marcar todos</span> | 
              <span class="link-action" onclick="toggleAllChips('turno', false)">Desmarcar</span>
            </span>
          </label>
          <div class="chips-group" id="turnoChipsContainer">
            <!-- Chips dinámicos -->
          </div>
        </div>

        <!-- Selección de Cargos -->
        <div class="filter-block">
          <label>
            <span>👔 Cargos Seleccionados (Prioriza Supervisor / Operario)</span>
            <span class="chip-actions">
              <span class="link-action" onclick="toggleAllChips('cargo', true)">Marcar todos</span> | 
              <span class="link-action" onclick="toggleAllChips('cargo', false)">Desmarcar</span>
            </span>
          </label>
          <div class="chips-group" id="cargoChipsContainer">
            <!-- Chips dinámicos -->
          </div>
        </div>
      </div>
    </section>

    <!-- BLOQUE 1: KPIs DE COBERTURA CONTRACTUAL -->
    <div class="section-title">📊 1. Control de Dotación Contractual (TR)</div>
    <section class="kpis-grid">
      <div class="kpi-box accent-blue">
        <div class="label">Meta Contractual (TR)</div>
        <div class="val" id="kpiTR">0</div>
        <div class="foot"><span>Total exigido según contrato</span></div>
      </div>

      <div class="kpi-box accent-green">
        <div class="label">Asistencia Efectiva Válida</div>
        <div class="val" id="kpiAsistEfectiva">0</div>
